---
import type { Gallery } from "../gallery";
import GalleryImage from "./GalleryImage.astro";

interface Props {
  gallery: Gallery;
  id: string;
  class?: string;
  imageClass?: string;
}

const { gallery, id, class: klass, imageClass } = Astro.props;
---

<div class:list={["section", klass]}>
  <GalleryImage {gallery} {id} class={imageClass} />
</div>
