---
import type { HTMLAttributes } from "astro/types";
import type { Gallery } from "../gallery";
import GalleryImage from "./GalleryImage.astro";
import GallerySection from "./GallerySection.astro";

interface Props extends Omit<HTMLAttributes<"div">, "class" | "id"> {
  gallery: Gallery;
  id: string;
  class?: string;
  imageClass?: string;
}

const { gallery, id, class: klass, imageClass, ...attributes } = Astro.props;
---

<GallerySection class={klass} {...attributes}>
  <GalleryImage {gallery} {id} class={imageClass} />
</GallerySection>
