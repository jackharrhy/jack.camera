---
import GalleryImage from "../components/GalleryImage.astro";
import PhotoSection from "../components/PhotoSection.astro";
import {
  mediaFileUrl,
  requireGalleryMedia,
  type Gallery,
} from "../gallery";
import "../styles/gallery.css";
import ArtistCard from "./fly-fest-oct2022/ArtistCard.astro";

interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;

const wallpaperId = "flyfest-overall-wellness-wallpaper";
const wallpaper = requireGalleryMedia(gallery, "assets", wallpaperId);
const wallpaperUrl = mediaFileUrl(gallery, wallpaper);
---

<main class="gallery-page fly-fest-gallery">
    <header>
      <GalleryImage
        {gallery}
        id="poster"
        kind="assets"
        alt="Fly Festival poster"
      />
      <p>
        photos from fly festival, from the camera & website of <a
          href="https://jackharrhy.dev">jack harrhy</a
        >
      </p>
    </header>

    <div class="notice">
      <p>NOTICE!</p>
      <div>
        <p>
          the original (high quality) images can be accessed by clicking on the
          photos in this view (which will bring you to a subpage),
        </p>
        <p>
          if you plan on posting any of these, make sure you use these instead
          of the versions on this page &lt;3
        </p>
      </div>
      <p>NOTICE!</p>
    </div>

    <div class="section double posters">
      <div>
        <GalleryImage {gallery} id="poster-alt" kind="assets" />
        <GalleryImage {gallery} id="poster-on-pole" />
      </div>
    </div>

    <ArtistCard
      {gallery}
      asset="cd-andrew-smith"
      href="https://www.instagram.com/andrwsmth0/"
      label="@andrwsmth0"
    />
    <PhotoSection {gallery} id="andrew-vert-flare" />
    <PhotoSection {gallery} id="andrew-vert-flare-alt" />
    <div class="insert dino">
      <GalleryImage {gallery} id="dino" />
    </div>
    <PhotoSection {gallery} id="andrew-crowd-front" />
    <PhotoSection {gallery} id="andrew-crowd-side" />
    <PhotoSection {gallery} id="andrew-front" />

    <ArtistCard
      {gallery}
      asset="cd-greta"
      href="https://www.instagram.com/gretaandthegoldfish/"
      label="@gretaandthegoldfish"
    />
    <PhotoSection {gallery} id="greta-setup" />
    <PhotoSection {gallery} id="greta-christian-vert" />
    <PhotoSection {gallery} id="greta-herself-vert" />
    <PhotoSection {gallery} id="greta-herself-front" />
    <PhotoSection {gallery} id="greta-christian-front" />
    <PhotoSection {gallery} id="greta-aidan-sing-keeb" />
    <PhotoSection {gallery} id="greta-raine-vert" />
    <PhotoSection {gallery} id="greta-aidan-vert" />
    <PhotoSection {gallery} id="greta-crowd" />
    <PhotoSection {gallery} id="greta-crowd-zoom" />
    <PhotoSection {gallery} id="greta-crowd-behind" />
    <PhotoSection {gallery} id="greta-crowd-behind-flare" />

    <div class="headstone" aria-hidden="true"><p>🪦</p></div>
    <PhotoSection {gallery} id="zombie-crowd-1" class="zombie" />
    <PhotoSection {gallery} id="zombie-crowd-2" class="zombie" />
    <PhotoSection {gallery} id="zombie-closeup" class="zombie" />
    <PhotoSection {gallery} id="zombie-dead" class="zombie" />
    <div class="headstone" aria-hidden="true"><p>🪦</p></div>

    <ArtistCard
      {gallery}
      asset="cd-cuperos"
      href="https://www.instagram.com/cuerpos_bodies/"
      label="@cuerpos_bodies"
    />
    <PhotoSection {gallery} id="cuperos-front-setup" />
    <PhotoSection {gallery} id="cuperos-side" />
    <PhotoSection {gallery} id="cuperos-francis-keeb" />
    <PhotoSection {gallery} id="cuperos-francis-keeb-closer" />
    <PhotoSection {gallery} id="cuperos-nadia" />
    <PhotoSection {gallery} id="cuperos-front-playing" />
    <div class="section double knobs">
      <div>
        <GalleryImage
          {gallery}
          id="cuperos-james-with-knobs-vert"
          class="small"
        />
        <GalleryImage {gallery} id="cuperos-james-with-knobs" />
      </div>
    </div>
    <PhotoSection {gallery} id="cuperos-nadia-vert" />
    <PhotoSection {gallery} id="cuperos-side-alt" />
    <div class="section sparkles">
      <p aria-hidden="true">✨</p>
      <GalleryImage {gallery} id="cayley-and-emma" />
      <p aria-hidden="true">✨</p>
    </div>
    <div class="insert stickers">
      <GalleryImage {gallery} id="stickers" />
    </div>

    <ArtistCard
      {gallery}
      asset="cd-lexi"
      href="https://www.instagram.com/lexihicksmusic/"
      label="@lexihicksmusic"
    />
    <PhotoSection {gallery} id="lexi-herself-setup" />
    <div class="section double chris-setup">
      <div>
        <GalleryImage
          {gallery}
          id="lexi-chris-setup-behind"
          class="small"
        />
        <GalleryImage {gallery} id="lexi-chris-setup" />
      </div>
    </div>
    <PhotoSection {gallery} id="lexi-setup" />
    <PhotoSection {gallery} id="lexi-aidan-setup" />
    <PhotoSection {gallery} id="lexi-front" />
    <PhotoSection {gallery} id="lexi-side" />
    <PhotoSection {gallery} id="lexi-raine" />
    <PhotoSection {gallery} id="lexi-front-darker" />
    <div class="section trading">
      <GalleryImage {gallery} id="trading" kind="assets" />
    </div>

    <ArtistCard
      {gallery}
      asset="cd-weary"
      href="https://www.instagram.com/wearyband/"
      label="@wearyband"
    />
    <PhotoSection {gallery} id="weary-side" />
    <PhotoSection {gallery} id="weary-christopher-side" />
    <PhotoSection {gallery} id="weary-christopher-front" />
    <PhotoSection {gallery} id="weary-kate-front" />
    <PhotoSection {gallery} id="weary-meg" />
    <PhotoSection {gallery} id="weary-front" />

    <ArtistCard
      {gallery}
      asset="cd-planes"
      href="https://www.instagram.com/imaginary.planes/"
      label="@imaginary.planes"
    />
    <PhotoSection {gallery} id="planes-james-front" />
    <div class="section double planes-double-1">
      <div>
        <GalleryImage {gallery} id="planes-raine-front" class="raine" />
        <GalleryImage {gallery} id="planes-james-flare" />
      </div>
    </div>
    <div class="section double planes-double-2">
      <div>
        <GalleryImage {gallery} id="planes-raine-side" />
        <GalleryImage {gallery} id="planes-nick" class="nick" />
      </div>
    </div>
    <PhotoSection {gallery} id="planes-front" />
    <PhotoSection {gallery} id="planes-side" />
    <PhotoSection {gallery} id="planes-nick-alt" />
    <PhotoSection {gallery} id="planes-james-sing-front" />
    <PhotoSection {gallery} id="planes-side-alt" />

    <ArtistCard
      {gallery}
      asset="porta-fly-fest"
      href="https://www.instagram.com/flyfestnl/"
      label="@flyfestnl"
    />
    <PhotoSection {gallery} id="organizers" />

    <div class="section wellness">
      <GalleryImage {gallery} id="overall-wellness" kind="assets" />
      <a href={wallpaperUrl} download="flyfest-overall-wellness-wallpaper.png">
        <button>download desktop wallpaper</button>
      </a>
    </div>
</main>

<style is:global>
  .fly-fest-gallery img {
    width: auto;
    height: auto;
  }

  .fly-fest-gallery > header {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    padding: 0 1rem;
    text-align: center;
  }

  .fly-fest-gallery > header img {
    max-width: 100%;
    max-height: 85%;
  }

  .fly-fest-gallery > header p {
    padding: 0 1rem;
  }

  .fly-fest-gallery .notice {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    background-color: rgba(255, 0, 0, 0.2);
    padding: 1rem 3rem;
  }

  .fly-fest-gallery .notice > p {
    margin: 0;
    text-align: center;
    font-size: 1.5rem;
    font-style: italic;
    color: rgba(0, 0, 0, 0.5);
  }

  .fly-fest-gallery .section > div {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    max-height: 100%;
    padding: 0 2rem;
  }

  .fly-fest-gallery .sparkles p {
    margin: 1rem 4rem;
    font-size: 5rem;
  }

  .fly-fest-gallery .insert {
    display: flex;
    align-items: center;
    justify-content: center;
    max-height: 60vh;
    padding: 1rem 2rem;
  }

  .fly-fest-gallery .insert img {
    max-width: 100%;
    max-height: 60%;
  }

  .fly-fest-gallery .dino img {
    border: 4px solid #d27b4f;
  }

  .fly-fest-gallery .stickers img {
    border: 5px solid #dc9400;
  }

  .fly-fest-gallery .posters {
    background-color: #191c1d;
    padding: 4rem;
  }

  .fly-fest-gallery .posters img {
    aspect-ratio: 2.5 / 4;
  }

  .fly-fest-gallery .double img {
    margin: 0 1rem;
  }

  .fly-fest-gallery .planes-double-1 .raine,
  .fly-fest-gallery .planes-double-2 .nick {
    height: 70%;
  }

  .fly-fest-gallery .trading img {
    height: 50%;
    transition: all ease-out 0.35s;
    transform: rotate(-2deg);
  }

  .fly-fest-gallery .trading img:hover {
    transform: scale(1.5) rotate(-1deg);
  }

  .fly-fest-gallery .chris-setup .small {
    height: 50%;
    margin-right: 1rem;
  }

  .fly-fest-gallery .knobs .small {
    height: 50%;
  }

  .fly-fest-gallery .double > div {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    max-height: 100%;
    padding: 0 2rem;
    aspect-ratio: 2 / 1.6;
  }

  .fly-fest-gallery .knobs > div {
    aspect-ratio: 5 / 3;
  }

  .fly-fest-gallery .planes-double-1 > div,
  .fly-fest-gallery .planes-double-2 > div {
    aspect-ratio: 5.1 / 3;
  }

  .fly-fest-gallery .headstone p {
    margin: 2rem 0;
    font-size: 6rem;
  }

  .fly-fest-gallery .zombie {
    background-color: black;
  }

  .fly-fest-gallery .wellness {
    flex-direction: column;
    margin-top: 15rem;
  }

  .fly-fest-gallery .wellness button {
    margin-top: 3rem;
    padding: 0.5rem 1rem;
    font-size: 1.25rem;
    font-family: monospace;
    background-color: white;
  }

  .fly-fest-gallery .wellness img {
    height: 50%;
  }

  @media (max-width: 1200px) {
    .fly-fest-gallery > header,
    .fly-fest-gallery .section,
    .fly-fest-gallery .insert {
      height: auto;
    }

    .fly-fest-gallery .sparkles,
    .fly-fest-gallery .double {
      flex-direction: column;
    }

    .fly-fest-gallery .sparkles img {
      max-height: 75%;
    }

    .fly-fest-gallery .posters img {
      margin: 1rem;
    }
  }
</style>
