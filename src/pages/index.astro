---
import Layout from "../layouts/Layout.astro";
import { listGalleries } from "../gallery";
import { hasGalleryView } from "../gallery-views";

const galleries = (await listGalleries()).filter((gallery) =>
  hasGalleryView(gallery.id),
);
---

<Layout title="home" centerContent>
  <main>
    <h1>jack.camera</h1>
    <ul>
      {
        galleries.map((gallery) => (
          <li>
            <a href={`/${gallery.id}`}>{gallery.data.title}</a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>

<style>
  main {
    text-align: center;
  }

  ul {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  h1 {
    font-size: 5rem;
  }

  li {
    font-size: 3rem;
  }

  @media (max-width: 800px) {
    h1 {
      font-size: 3rem;
    }

    li {
      font-size: 1.5rem;
    }

    ul {
      padding: 0;
      list-style: none;
    }
  }
</style>
