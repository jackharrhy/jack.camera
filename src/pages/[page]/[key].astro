---
import type { GetStaticPaths } from "astro";

import {
  formatPhotoDetails,
  listGalleries,
  listGalleryMedia,
  mediaAlt,
  mediaFileUrl,
  mediaRouteId,
  type Gallery,
  type GalleryMedia,
} from "../../gallery";
import { hasGalleryView } from "../../gallery-views";
import Layout from "../../layouts/Layout.astro";

interface Props {
  gallery: Gallery;
  media: GalleryMedia;
}

export const getStaticPaths = (async () => {
  const galleries = (await listGalleries()).filter((gallery) =>
    hasGalleryView(gallery.id),
  );

  return galleries.flatMap((gallery) =>
    listGalleryMedia(gallery).map((media) => ({
      params: {
        page: gallery.id,
        key: mediaRouteId(media.kind, media.id),
      },
      props: { gallery, media },
    })),
  );
}) satisfies GetStaticPaths;

const { gallery, media } = Astro.props;
const about =
  media.kind === "photos" ? formatPhotoDetails(media.data) : undefined;
---

<Layout title={`${gallery.data.title} - ${mediaAlt(media.id)}`}>
  <main>
    <img
      src={mediaFileUrl(gallery, media)}
      alt={mediaAlt(media.id)}
      decoding="async"
      width={media.data.dimensions.width}
      height={media.data.dimensions.height}
    />
    {about && <p>{about}</p>}
  </main>
</Layout>

<style>
  main {
    display: flex;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: black;
    color: rgba(255, 255, 255, 0.6);
  }

  img {
    width: auto;
    height: auto;
    max-width: 80vw;
    max-height: 80vh;
    margin: 0 auto;
  }

  p {
    margin: 1rem;
    text-align: center;
  }
</style>
